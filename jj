    def extract_app_code(self, subject):
        clean_sub = subject.strip()
        match = re.match(r'(?i)^CRI\d+$', clean_sub)
        if match:
            return clean_sub.upper()
        return None

    def convert_to_ist(self, utc_time_str):
        if not utc_time_str:
            return "N/A"
        try:
            dt = datetime.strptime(utc_time_str, "%Y-%m-%dT%H:%M:%SZ")
            dt = dt.replace(tzinfo=ZoneInfo("UTC"))
            ist_dt = dt.astimezone(ZoneInfo("Asia/Kolkata"))
            return ist_dt.strftime("%d-%m-%y %I:%M:%S %p")
        except Exception:
            return utc_time_str

    def _send_request_with_retry(self, session, method, url, headers, json_payload=None, max_retries=3, delay=1.5):
        """Executes HTTP requests with automatic retry on transient errors and immediate return on valid/client responses."""
        for attempt in range(1, max_retries + 1):
            try:
                if method.upper() == "POST":
                    resp = session.post(url, headers=headers, json=json_payload, timeout=25)
                else:
                    resp = session.get(url, headers=headers, timeout=25)
                
                # If success or client error (4xx), return immediately to let caller handle or fallback
                if resp.status_code == 200 or (400 <= resp.status_code < 500):
                    return resp

                logging.warning(f"[Retry {attempt}/{max_retries}] Status {resp.status_code} for {url}. Waiting {delay}s...")
            except requests.RequestException as e:
                logging.warning(f"[Retry {attempt}/{max_retries}] Exception for {url}: {e}. Waiting {delay}s...")
            
            time.sleep(delay)
        return None

    def generate_xray_report(self, mail_text, application_code):
        """Extracts JFrog URLs, authenticates dynamically, and builds clean HTML report supporting both URL formats."""
        mail_text = mail_text.replace("&amp;", "&")
        
        # Capture both lower-artifactory and ue1-lower-artifactory
        raw_urls = re.findall(r"(?i)https://(?:ue1-)?lower-artifactory\.crisil\.local[^\s<>\"']+", mail_text)
        
        # Clean trailing punctuation from email links
        urls = []
        for u in raw_urls:
            cleaned = u.rstrip(".,;:)>]'\"")
            if cleaned not in urls:
                urls.append(cleaned)
        
        if not urls:
            return None
            
        logging.info(f"Found {len(urls)} JFrog URLs for {application_code}. Initiating Xray scan...")
        
        session = requests.Session()
        session.verify = False
        common_headers = {
            "Accept": "application/json, text/plain, */*",
            "Content-Type": "application/json",
            "X-Requested-With": "XMLHttpRequest",
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.5735.199 Safari/537.36"
        }

        # Identify unique base URLs present in extracted links
        base_urls = set(f"{urlparse(u).scheme}://{urlparse(u).netloc}" for u in urls)

        # Authenticate once using SSO
        try:
            driver = webdriver.Edge()
            first_base = list(base_urls)[0]

            driver.get(first_base)

            input(
                "\nComplete Microsoft SSO login in Edge "
                "and press Enter once JFrog is loaded..."
            )

            selenium_cookies = driver.get_cookies()
            driver.quit()

            # Copy browser cookies across session and all domains
            access_token = None
            for cookie in selenium_cookies:
                c_name = cookie["name"]
                c_val = cookie["value"]
                session.cookies.set(c_name, c_val)
                for base in base_urls:
                    session.cookies.set(c_name, c_val, domain=urlparse(base).netloc)
                if c_name == "ACCESSTOKEN":
                    access_token = c_val

            if access_token:
                common_headers["Authorization"] = f"Bearer {access_token}"

            # Validate session against all JFrog instances
            for base in base_urls:
                validation_response = session.get(
                    f"{base}/ui/",
                    headers=common_headers,
                    verify=False,
                    allow_redirects=True
                )

                if validation_response.status_code != 200:
                    logging.error(f"JFrog Authentication Failed for {base}: {validation_response.status_code}")
                    return None

                logging.info(f"JFrog Authentication Successful: {base}")

        except Exception as e:
            logging.error(f"JFrog Connection Error: {e}")
            return None

        all_reports = []

        for jfrog_url in urls:
            try:
                parsed = urlparse(jfrog_url)
                current_base_url = f"{parsed.scheme}://{parsed.netloc}"
                params = parse_qs(parsed.query)

                # Condition 1: Legacy query-string parameters
                package_id = unquote(params.get("package_id", [""])[0])
                path = unquote(params.get("path", [""])[0])
                version = unquote(params.get("version", [""])[0])
                component_id = unquote(params.get("component_id", [""])[0])

                # Condition 2: Tree-view URLs (/ui/repos/tree/...)
                if not path and "/ui/repos/tree/" in parsed.path:
                    after_tree = parsed.path.split("/ui/repos/tree/", 1)[-1]
                    tree_parts = [p for p in after_tree.split("/") if p]
                    
                    if tree_parts:
                        # Strip standard UI tab name if present (General, Xray, etc.)
                        if tree_parts[0].lower() in ['general', 'xray', 'properties', 'builds', 'releasebundles']:
                            path = unquote("/".join(tree_parts[1:]))
                        else:
                            path = unquote("/".join(tree_parts))

                if not path or "/" not in path:
                    logging.warning(f"Could not extract a valid repository path from URL: {jfrog_url}")
                    continue

                repo, artifact_path = path.split("/", 1)
                path_tokens = artifact_path.split("/")
                
                # Service name identification
                if "pipeline" in path_tokens and "build" in path_tokens:
                    try:
                        b_idx = path_tokens.index("build")
                        service_name = path_tokens[b_idx + 1]
                    except Exception:
                        service_name = path_tokens[5] if len(path_tokens) > 5 else os.path.basename(artifact_path)
                elif len(path_tokens) > 5:
                    service_name = path_tokens[5]
                else:
                    service_name = os.path.basename(artifact_path)

                # Fetch artifact scan status first
                artifact_status_url = f"{current_base_url}/ui/api/v1/xray/ui/unified/artifact/status"
                artifact_resp = self._send_request_with_retry(
                    session, "POST", artifact_status_url, common_headers, {"path": artifact_path, "repo": repo}
                )
                
                artifact_json = artifact_resp.json() if artifact_resp and artifact_resp.status_code == 200 else {}
                sca = artifact_json.get("details", {}).get("sca", {})
                violations = artifact_json.get("details", {}).get("violations", {})

                # Populate component metadata dynamically if missing from query params
                if not component_id:
                    component_id = artifact_json.get("component_id") or artifact_json.get("details", {}).get("component_id", "")
                if not package_id:
                    package_id = artifact_json.get("package_id") or artifact_json.get("details", {}).get("package_id", "")
                if not version:
                    version = artifact_json.get("version") or artifact_json.get("details", {}).get("version", "")

                # Storage properties fallback if metadata is still unresolved
                if not package_id or not version or not component_id:
                    storage_url = f"{current_base_url}/artifactory/api/storage/{repo}/{artifact_path}?properties"
                    storage_resp = self._send_request_with_retry(session, "GET", storage_url, common_headers)
                    if storage_resp and storage_resp.status_code == 200:
                        props = storage_resp.json().get("properties", {})
                        gav_list = props.get("artifactory.gav", [])
                        if gav_list:
                            gav_val = gav_list[0]
                            component_id = component_id or f"gav://{gav_val}"
                            gav_parts = gav_val.split(":")
                            if len(gav_parts) >= 3:
                                package_id = package_id or f"gav://{gav_parts[0]}:{gav_parts[1]}"
                                version = version or gav_parts[2]

                # Component reconstruction if partial info exists
                if component_id and (not package_id or not version):
                    if ":" in component_id:
                        p_id, v_val = component_id.rsplit(":", 1)
                        package_id = package_id or p_id
                        version = version or v_val
                elif not component_id and package_id and version:
                    component_id = f"{package_id}:{version}"

                # 1. Query Policy Violations API (Dual payload strategy)
                policy_url = f"{current_base_url}/ui/api/v1/xray/ui/userIssues/dashboard/policyViolations"
                policy_payload_modern = {
                    "repo": repo,
                    "path": path,
                    "package_id": package_id,
                    "version": version,
                    "component_id": component_id
                }
                policy_resp = self._send_request_with_retry(session, "POST", policy_url, common_headers, policy_payload_modern)
                
                # Fallback to legacy payload format if modern payload is rejected
                if not policy_resp or policy_resp.status_code != 200:
                    policy_payload_legacy = {"package_id": package_id, "path": path, "version": version}
                    policy_resp = self._send_request_with_retry(session, "POST", policy_url, common_headers, policy_payload_legacy)

                policy_severity = policy_resp.json().get("severity_count", {}) if policy_resp and policy_resp.status_code == 200 else {}

                # 2. Query Vulnerabilities API (Dual payload strategy)
                vuln_url = f"{current_base_url}/ui/api/v1/xray/ui/component/dashboard/vulnerabilities"
                vuln_payload_modern = {
                    "repo": repo,
                    "path": path,
                    "package_id": package_id,
                    "version": version,
                    "component_id": component_id,
                    "issue_kind": 0
                }
                vuln_resp = self._send_request_with_retry(session, "POST", vuln_url, common_headers, vuln_payload_modern)

                # Fallback to legacy payload format if modern payload is rejected
                if not vuln_resp or vuln_resp.status_code != 200:
                    vuln_payload_legacy = {
                        "package_id": package_id, "path": path, "version": version,
                        "multiScanId": "", "scanType": "repositories", "isGitRepoMultiscan": False,
                        "issue_kind": 0, "isGitRepo": False
                    }
                    vuln_resp = self._send_request_with_retry(session, "POST", vuln_url, common_headers, vuln_payload_legacy)

                vuln_severity = vuln_resp.json().get("severity_count", {}) if vuln_resp and vuln_resp.status_code == 200 else {}

                all_reports.append({
                    "service": service_name,
                    "policy": {
                        "critical": policy_severity.get("critical", 0),
                        "high": policy_severity.get("high", 0),
                        "medium": policy_severity.get("medium", 0),
                        "low": policy_severity.get("low", 0)
                    },
                    "vuln": {
                        "critical": vuln_severity.get("critical", 0),
                        "high": vuln_severity.get("high", 0),
                        "medium": vuln_severity.get("medium", 0),
                        "low": vuln_severity.get("low", 0)
                    },
                    "sca_status": sca.get("status", "N/A"),
                    "sca_time": self.convert_to_ist(sca.get("time")),
                    "violation_status": violations.get("status", "N/A"),
                    "violation_time": self.convert_to_ist(violations.get("time"))
                })
            except Exception as ex:
                logging.warning(f"Error parsing JFrog URL {jfrog_url}: {ex}")

        if not all_reports:
            return None

        # Build Consolidated Totals
        grand_totals = {
            "policy": {
                "critical": sum(x["policy"]["critical"] for x in all_reports),
                "high": sum(x["policy"]["high"] for x in all_reports),
                "medium": sum(x["policy"]["medium"] for x in all_reports),
                "low": sum(x["policy"]["low"] for x in all_reports)
