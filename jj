        }
        overall = {
            "critical": grand_totals["policy"]["critical"] + grand_totals["vuln"]["critical"],
            "high": grand_totals["policy"]["high"] + grand_totals["vuln"]["high"],
            "medium": grand_totals["policy"]["medium"] + grand_totals["vuln"]["medium"],
            "low": grand_totals["policy"]["low"] + grand_totals["vuln"]["low"]
        }

        # Generate Clean HTML
        html_report = f"""
        <html>
        <head><title>XRAY Report - {application_code}</title>
        <style>
            body {{ font-family: Arial, sans-serif; margin: 20px; }}
