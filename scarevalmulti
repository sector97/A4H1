def process_single_tracker_worker(file_type, config, cache, ist):
    tracker_name = file_type.capitalize()
    path = config["path"]
    sheet = config["sheet"]
    
    local_changes = []
    local_findings = []
    updated_rows = 0

    if not os.path.exists(path):
        return tracker_name, 0, local_changes, local_findings, f"⚠️ Revalidation file not found: {path}"

    try:
        wb_val = openpyxl.load_workbook(path, data_only=True)
        wb_rw = openpyxl.load_workbook(path)
        
        if sheet not in wb_val.sheetnames: 
            return tracker_name, 0, local_changes, local_findings, f"⚠️ Sheet not found in {path}"
            
        ws_val = wb_val[sheet]
        ws_rw = wb_rw[sheet]
        
        # Fast header extraction
        header_cells = list(ws_val[1])
        headers = {str(c.value).strip().lower(): idx for idx, c in enumerate(header_cells, start=1) if c.value}
        header_names = [str(c.value).strip() if c.value else None for c in header_cells]
        
        app_col = headers.get('application code')
        svc_col = headers.get('service name')
        uid_col = find_column(headers, ['unique id', 'uniqueid'])
        status_col = headers.get('status', config["status_col"])

        op_comp_col = find_column(headers, ['component name', 'component', 'artifact'])
        op_ver_col = find_column(headers, ['version in use', 'version'])
        sec_id_col = find_column(headers, ['id', 'issue id', 'vulnerability id'])
        sec_path_col = find_column(headers, ['component physical paths', 'physical path'])
        viol_comp_col = find_column(headers, ['component name', 'component', 'artifact'])
        lic_comp_col = find_column(headers, ['component name', 'component', 'artifact'])

        if not all([app_col, svc_col, uid_col]):
            return tracker_name, 0, local_changes, local_findings, f"⚠️ Missing critical metadata columns in {path}. Skipping."

        # High-Speed In-Memory Row Iteration (No slow .cell() lookups!)
        for row_idx, row_vals in enumerate(ws_val.iter_rows(min_row=2, values_only=True), start=2):
            cell_app_raw = str(row_vals[app_col - 1] or "").strip()
            cell_svc_raw = str(row_vals[svc_col - 1] or "").strip()
            dict_key = (cell_app_raw.lower(), cell_svc_raw.lower())
            
            if dict_key in cache:
                csv_uids_for_this_app = cache[dict_key]
                cell_uid_raw = str(row_vals[uid_col - 1] or "").strip()
                
                if not cell_uid_raw or cell_uid_raw.startswith("="):
                    if file_type == "operational":
                        comp = str(row_vals[op_comp_col - 1] or "").strip() if op_comp_col else ""
                        ver = str(row_vals[op_ver_col - 1] or "").strip() if op_ver_col else ""
                        cell_uid_raw = f"{comp} {ver} {cell_svc_raw} {cell_app_raw}"
                    elif file_type == "security":
                        s_id = str(row_vals[sec_id_col - 1] or "").strip() if sec_id_col else ""
                        s_path = str(row_vals[sec_path_col - 1] or "").strip() if sec_path_col else ""
                        cell_uid_raw = f"{s_id} {s_path} {cell_svc_raw} {cell_app_raw}"
                    elif file_type == "violations":
                        comp = str(row_vals[viol_comp_col - 1] or "").strip() if viol_comp_col else ""
                        cell_uid_raw = f"{comp} {cell_svc_raw} {cell_app_raw}"
                    elif file_type == "licenses":
                        comp = str(row_vals[lic_comp_col - 1] or "").strip() if lic_comp_col else ""
                        cell_uid_raw = f"{comp} {cell_svc_raw} {cell_app_raw}"

                # Aggressive Regex to strip trailing Date-Time formats if previously leaked
                clean_uid = re.sub(r'\s+\d{4}-\d{2}-\d{2}\s\d{2}:\d{2}:\d{2}$', '', cell_uid_raw)
                cell_uid_normalized = " ".join(clean_uid.lower().split())
                
                old_status_raw = str(row_vals[status_col - 1] or "").strip()
                old_status_clean = old_status_raw.title()
                new_status = 'Open' if cell_uid_normalized in csv_uids_for_this_app else 'Closed'

                # OVERWRITE the formula natively using Write Mode
                ws_rw.cell(row=row_idx, column=uid_col).value = " ".join(clean_uid.split())

                if old_status_clean != new_status:
                    if old_status_clean == "Closed" and new_status == "Open": action_taken = "Reopened"
                    elif old_status_clean == "Open" and new_status == "Closed": action_taken = "Closed"
                    else: action_taken = "Status Corrected"
                    
                    ws_rw.cell(row=row_idx, column=status_col).value = new_status
                    current_time_ist = datetime.now(ist).strftime('%d-%b-%Y %I:%M:%S %p')
                    
                    local_changes.append({
                        "Date & Time (IST)": current_time_ist,
                        "Action Taken": action_taken,
                        "Application Code": cell_app_raw,
                        "Master Tracker": os.path.basename(path),
                        "Row Number": row_idx,
                        "Service Name": cell_svc_raw,
                        "Unique Id": clean_uid,
                        "Previous Status": old_status_raw,
                        "New Status": new_status
                    })
                    updated_rows += 1
                    
                # Ultra-Fast Full Row Extraction to a Dictionary (No cell lookups)
                row_dict = {}
                for col_idx, h_name in enumerate(header_names, start=1):
                    if h_name:
                        if col_idx == uid_col:
                            row_dict[h_name] = " ".join(clean_uid.split())
                        elif col_idx == status_col and old_status_clean != new_status:
                            row_dict[h_name] = new_status
                        else:
                            row_dict[h_name] = row_vals[col_idx - 1]
                            
                row_dict["_Internal_App_Code"] = cell_app_raw
                row_dict["_Internal_Tracker"] = tracker_name
                local_findings.append(row_dict)

        if updated_rows > 0 or cache:
            wb_rw.save(path)
            return tracker_name, updated_rows, local_changes, local_findings, f"✅ Batch Saved: {updated_rows} statuses & findings updated in {os.path.basename(path)}"
        else:
            return tracker_name, 0, local_changes, local_findings, f"ℹ️ Processed cleanly: No changes required in {os.path.basename(path)}"

    except PermissionError: 
        return tracker_name, 0, [], [], f"❌ PERMISSION ERROR: Could not save '{os.path.basename(path)}'. Ensure it is closed."
    except Exception as e: 
        return tracker_name, 0, [], [], f"❌ Error updating {path}: {str(e)}"


def batch_update_master_files():
    """Trigger parallel threads to process all Master Trackers concurrently."""
    global CHANGE_SUMMARY, CHANGE_LOGS, ALL_REVALIDATED_FINDINGS
    safe_print("\n" + "=" * 70)
    safe_print("STARTING HIGH-SPEED PARALLEL MASTER VALIDATION...")
    safe_print("=" * 70)
    
    ist = timezone(timedelta(hours=5, minutes=30))
    futures = []

    # Run Master Trackers in Parallel Threads
    with ThreadPoolExecutor(max_workers=4) as executor:
        for file_type, config in REVALIDATION_FILES.items():
            cache = GLOBAL_EXTRACTED_UIDS.get(file_type, {})
            if cache:
                futures.append(executor.submit(process_single_tracker_worker, file_type, config, cache, ist))
                
    for future in as_completed(futures):
        tracker_name, updated_rows, local_changes, local_findings, msg = future.result()
        CHANGE_SUMMARY[tracker_name] += updated_rows
        CHANGE_LOGS.extend(local_changes)
        ALL_REVALIDATED_FINDINGS.extend(local_findings)
        safe_print(msg)


