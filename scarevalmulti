def export_app_code_reports(app_code, log_group, findings_group):
    """Worker function to save report files to disk in parallel."""
    safe_app_code = clean_filename(app_code) if app_code.strip() else "Uncategorized"
    os.makedirs(safe_app_code, exist_ok=True)
    
    # 1. Output the Standard Change Logs
    if log_group is not None and not log_group.empty:
        log_path = os.path.join(safe_app_code, "Revalidation_Change_Log.xlsx")
        try:
            log_group.to_excel(log_path, index=False)
            safe_print(f"✅ Change log saved: {os.path.abspath(log_path)}")
        except PermissionError: 
            safe_print(f"❌ PERMISSION ERROR: Could not save {log_path}.")
            
    # 2. Output the Full Revalidated Findings Report
    if findings_group is not None and not findings_group.empty:
        findings_path = os.path.join(safe_app_code, "Revalidated_Findings.xlsx")
        try:
            with pd.ExcelWriter(findings_path, engine='openpyxl') as writer:
                for tracker in ["Operational", "Security", "Violations", "Licenses"]:
                    tracker_group = findings_group[findings_group["_Internal_Tracker"] == tracker]
                    if not tracker_group.empty:
                        out_df = tracker_group.drop(columns=["_Internal_App_Code", "_Internal_Tracker"])
                        out_df.to_excel(writer, sheet_name=tracker, index=False)
            safe_print(f"✅ Revalidated Findings saved: {os.path.abspath(findings_path)}")
        except PermissionError: 
            safe_print(f"❌ PERMISSION ERROR: Could not save {findings_path}.")


def print_final_summary_and_save():
    print("\n" + "=" * 70)
    print("FINAL REVALIDATION SUMMARY")
    print("=" * 70)
    for tracker, count in CHANGE_SUMMARY.items():
        if count > 0: print(f"🔄 {tracker.ljust(12)} Tracker : {count} changes made")
        else: print(f"✅ {tracker.ljust(12)} Tracker : 0 changes made")
    print("=" * 70)

    # Use multithreading to rapidly write output excel files to disk
    if (sum(CHANGE_SUMMARY.values()) > 0 and CHANGE_LOGS) or ALL_REVALIDATED_FINDINGS:
        print("\nGENERATING DETAILED REPORTS...")
        log_df = pd.DataFrame(CHANGE_LOGS) if CHANGE_LOGS else None
        findings_df = pd.DataFrame(ALL_REVALIDATED_FINDINGS) if ALL_REVALIDATED_FINDINGS else None
        
        unique_app_codes = set()
        if log_df is not None: unique_app_codes.update(log_df["Application Code"].unique())
        if findings_df is not None: unique_app_codes.update(findings_df["_Internal_App_Code"].unique())
        
        with ThreadPoolExecutor(max_workers=MAX_CONCURRENT_DOWNLOADS) as executor:
            for app_code in unique_app_codes:
                app_log_group = log_df[log_df["Application Code"] == app_code] if log_df is not None else None
                app_find_group = findings_df[findings_df["_Internal_App_Code"] == app_code] if findings_df is not None else None
                executor.submit(export_app_code_reports, app_code, app_log_group, app_find_group)
    else: 
        print("\nℹ️ No Excels were generated because no statuses required updating.")


